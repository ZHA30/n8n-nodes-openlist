{
  "name": "@zha303050/n8n-nodes-openlist",
  "version": "0.1.2",
  "description": "Work with OpenList files and folders in n8n",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "openlist"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "test": "npm run build && node --test tests/*.test.cjs",
    "lint:fix": "n8n-node lint --fix",
    "check:package": "node scripts/check-package.mjs"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/OpenListApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/OpenList/OpenList.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.56.1",
    "@types/node": "22.20.5",
    "n8n-workflow": "2.47.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "author": {
    "name": "ZHA30",
    "email": "zha303050@gmail.com"
  },
  "homepage": "https://github.com/ZHA30/n8n-nodes-openlist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZHA30/n8n-nodes-openlist.git"
  },
  "bugs": {
    "url": "https://github.com/ZHA30/n8n-nodes-openlist/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
